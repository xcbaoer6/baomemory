{
  "name": "baomemory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiered external memory service on Cloudflare Workers + Supabase, with REST and MCP interfaces.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.5",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
